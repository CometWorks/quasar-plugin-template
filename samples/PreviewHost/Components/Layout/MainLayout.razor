@inherits LayoutComponentBase

<div class="quasar-preview" data-theme="@(_dark ? "dark" : "light")">
    <header class="preview-topbar">
        <strong>Quasar Plugin Preview</strong>
        <NavLink href="" Match="NavLinkMatch.All"><PluginIcon Icon="@PluginIcons.Dashboard" />Preview</NavLink>
        <NavLink href="template-plugin"><PluginIcon Icon="@PluginIcons.Extension" />Template Plugin</NavLink>
        <button type="button" aria-label="Toggle preview theme" aria-pressed="@(_dark ? "true" : "false")"
                @onclick="@(() => _dark = !_dark)">
            <PluginIcon Icon="@(_dark ? PluginIcons.LightMode : PluginIcons.DarkMode)" />
            @(_dark ? "Light mode" : "Dark mode")
        </button>
    </header>
    <main class="preview-content">@Body</main>
</div>

@code {
    private bool _dark = true;
}
