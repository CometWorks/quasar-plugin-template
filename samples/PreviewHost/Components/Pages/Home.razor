@page "/"

<PageTitle>Quasar Plugin Preview</PageTitle>
<h1>Entity actions</h1>
<div class="preview-table-scroll">
    <table class="preview-table">
        <thead>
            <tr><th scope="col">Type</th><th scope="col">Entity</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var entity in _entities)
            {
                <tr @key="entity.EntityId">
                    <td>@entity.Type</td>
                    <td>@entity.Name</td>
                    <td>
                        <EntityAction AgentId="preview-agent" ServerName="Preview Server"
                            EntityId="@entity.EntityId" EntityType="@entity.Type" EntitySubType="@entity.SubType"
                            EntityDisplayName="@entity.Name" OwnerSteamId="@entity.OwnerSteamId" CanViewEntity="@entity.CanView" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private static readonly PreviewEntity[] _entities =
    [
        new(9007199254740993, "Grid", "LargeShip", "Freighter", 76561198000000001, true),
        new(281474976710682, "Character", "Player", "Engineer", null, false),
    ];

    private sealed record PreviewEntity(long EntityId, string Type, string SubType, string Name, ulong? OwnerSteamId, bool CanView);
}
