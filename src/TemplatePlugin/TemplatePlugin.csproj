<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TemplatePlugin</AssemblyName>
    <RootNamespace>TemplatePlugin</RootNamespace>
    <PackageId>TemplatePlugin</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="10.0.14" />
  </ItemGroup>

</Project>
