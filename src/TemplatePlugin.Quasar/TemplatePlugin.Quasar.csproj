<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TemplatePlugin.Quasar</AssemblyName>
    <RootNamespace>TemplatePlugin.Quasar</RootNamespace>
    <QuasarPluginAbstractionsProject Condition="'$(QuasarPluginAbstractionsProject)' == ''">../../../Quasar/Quasar.Plugin.Abstractions/Quasar.Plugin.Abstractions.csproj</QuasarPluginAbstractionsProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplatePlugin\TemplatePlugin.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(QuasarPluginAbstractionsAssembly)' != ''">
    <Reference Include="Quasar.Plugin.Abstractions">
      <HintPath>$(QuasarPluginAbstractionsAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(QuasarPluginAbstractionsAssembly)' == '' and Exists('$(QuasarPluginAbstractionsProject)')">
    <ProjectReference Include="$(QuasarPluginAbstractionsProject)" Private="false" />
  </ItemGroup>

  <Target Name="ValidateQuasarReferences" BeforeTargets="ResolveReferences" Condition="!Exists('$(QuasarPluginAbstractionsAssembly)') and ('$(QuasarPluginAbstractionsAssembly)' != '' or !Exists('$(QuasarPluginAbstractionsProject)'))">
    <Error Text="Set QuasarPluginAbstractionsAssembly to the worker's Quasar.Plugin.Abstractions.dll or QuasarPluginAbstractionsProject to the matching Quasar source project." />
  </Target>

</Project>
